---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("posts");
  return paginate(getSortedPosts(posts), {
    pageSize: config.posts.perPage,
  });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;

// 3대 핵심 카테고리 정의
const categories = [
  { name: "All", tag: "all" },
  { name: "RF & Microwave", tag: "RF & Microwave" },
  { name: "Coursework & Projects", tag: "Coursework & Projects" },
  { name: "Engineering Life", tag: "Engineering Life" },
];
---

<Layout title={`Posts | ${config.site.title}`}>
  <Header activeNav="posts" />
  <main id="main-content" class="app-layout my-1">
    <section class="pt-8 pb-6">
      <h1 class="text-2xl font-bold sm:text-3xl tracking-tight mb-2">
        Posts
      </h1>
      <p class="text-sm opacity-80 mb-6">
        Explore articles by category or view all posts in chronological order.
      </p>

      <!-- 카테고리 필터 버튼 영역 -->
      <div class="flex flex-wrap gap-2 pb-6 border-b border-border mb-8">
        {
          categories.map(cat => (
            <a
              href={
                cat.tag === "all"
                  ? getRelativeLocaleUrl(locale, "posts")
                  : getRelativeLocaleUrl(locale, `tags/${cat.tag.toLowerCase().replace(/ & /g, "-and-").replace(/ /g, "-")}`)
              }
              class="rounded-md border border-accent/30 bg-accent/10 px-3.5 py-1.5 text-xs font-semibold text-accent hover:bg-accent hover:text-white transition-colors"
            >
              {cat.name}
            </a>
          ))
        }
      </div>

      <!-- 포스트 목록 -->
      <ul>
        {page.data.map(data => <Card variant="h3" {...data} />)}
      </ul>
    </section>

    <Pagination {page} />
  </main>
  <Footer />
</Layout>
