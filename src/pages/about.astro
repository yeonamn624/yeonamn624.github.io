---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const { site } = config;
---

<Layout title={`About | ${site.title}`}>
  <Header activeNav="about" />
  <main id="main-content" class="app-layout my-1">
    <section class="pt-8 pb-10 border-b border-border">
      
      <!-- 1. Header & Profile (Profile + Intro + Contact Links) -->
      <div class="flex flex-col md:flex-row gap-8 items-center md:items-start mb-10 pb-8 border-b border-border">
        <!-- Profile Picture -->
        <div class="w-36 h-36 md:w-44 md:h-44 rounded-2xl overflow-hidden border-2 border-sky-600/40 shadow-md flex-shrink-0">
          <img
            src="/profile.jpg"
            alt="Jiwon Park Profile"
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Name, Affiliation, and Contact Links -->
        <div class="space-y-3 text-center md:text-left flex-1">
          <h1 class="text-2xl font-bold sm:text-3xl tracking-tight">
            Jiwon Park 
          </h1>
          <p class="text-xs font-bold text-sky-600 dark:text-sky-400 uppercase tracking-wider">
            Undergraduate Student • Electrical & Electronic Engineering, Yonsei University
          </p>
          <p class="text-sm leading-relaxed opacity-90">
            Hello! I am an undergraduate student in the School of Electrical and Electronic Engineering at Yonsei University. My primary academic focus centers on <strong>RF & Microwave Engineering</strong>, electromagnetics, and high-frequency circuit design.
          </p>
          <p class="text-sm leading-relaxed opacity-90">
            This space serves as my personal digital research log and <strong>online Curriculum Vitae (CV)</strong>, documenting coursework reflections, laboratory projects, and my ongoing academic journey.
          </p>

          <!-- Contact & Links (Integrated Header) -->
          <div class="pt-2 flex flex-wrap gap-4 text-xs font-semibold justify-center md:justify-start">
            <a
              href="https://github.com/yeonamn624"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-accent/10 border border-border text-sky-600 dark:text-sky-400 hover:bg-sky-500 hover:text-white transition-colors"
            >
              <span>🌐 GitHub</span>
            </a>
            <a
              href="mailto:your-email@yonsei.ac.kr"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-accent/10 border border-border text-orange-500 dark:text-orange-400 hover:bg-orange-500 hover:text-white transition-colors"
            >
              <span>✉️ Email</span>
            </a>
          </div>
        </div>
      </div>

      <!-- 2. Academic Interests -->
      <div class="mb-10">
        <h2 class="text-lg font-bold text-orange-500 dark:text-orange-400 mb-4 flex items-center gap-2">
          📡 Academic Interests
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="p-3.5 rounded-lg border border-border bg-accent/5 text-xs opacity-90">
            <strong class="text-sky-600 dark:text-sky-400 block mb-1">RF & Microwave Circuits</strong>
            High-frequency circuit analysis, modulation/demodulation theory, and RF front-end architecture.
          </div>
          <div class="p-3.5 rounded-lg border border-border bg-accent/5 text-xs opacity-90">
            <strong class="text-sky-600 dark:text-sky-400 block mb-1">Electromagnetics & Matching</strong>
            Antenna theory, wave propagation, and impedance matching via Smith Chart applications.
          </div>
        </div>
      </div>

      <!-- 3. Education & Coursework -->
      <div class="mb-10">
        <h2 class="text-lg font-bold text-sky-600 dark:text-sky-400 mb-4 flex items-center gap-2">
          🎓 Education & Coursework
        </h2>
        <div class="mb-4">
          <div class="flex justify-between items-baseline mb-1">
            <h3 class="text-sm font-semibold">Yonsei University</h3>
            <span class="text-xs opacity-60">Attending</span>
          </div>
          <p class="text-xs opacity-80">B.S. in Electrical and Electronic Engineering</p>
        </div>

        <div>
          <span class="text-xs font-semibold opacity-70 block mb-2">Relevant Coursework:</span>
          <div class="flex flex-wrap gap-2 text-xs">
            <span class="px-2.5 py-1 rounded bg-accent/10 border border-border">Electromagnetics</span>
            <span class="px-2.5 py-1 rounded bg-accent/10 border border-border">Circuit Theory</span>
            <span class="px-2.5 py-1 rounded bg-accent/10 border border-border">Signals & Systems</span>
            <span class="px-2.5 py-1 rounded bg-accent/10 border border-border">Digital Logic Design</span>
          </div>
        </div>
      </div>

      <!-- 4. Featured Projects -->
      <div class="mb-10">
        <h2 class="text-lg font-bold text-orange-500 dark:text-orange-400 mb-4 flex items-center gap-2">
          🚀 Featured Projects
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="rounded-lg border border-border p-5 bg-accent/5 hover:border-sky-500 transition-colors">
            <span class="text-[10px] font-semibold px-2 py-0.5 rounded bg-sky-100 text-sky-700 dark:bg-sky-950 dark:text-sky-300">
              Simulation
            </span>
            <h3 class="text-base font-semibold my-2">CMOS & Differential Pair Circuit Analysis</h3>
            <p class="text-xs opacity-80 leading-relaxed mb-3">
              Extraction and simulation of netlists for CMOS logic and differential pair circuits using PSpice and Xschem.
            </p>
            <div class="text-[11px] opacity-70 font-mono">PSpice • Xschem • Linux</div>
          </div>

          <div class="rounded-lg border border-border p-5 bg-accent/5 hover:border-orange-500 transition-colors">
            <span class="text-[10px] font-semibold px-2 py-0.5 rounded bg-orange-100 text-orange-700 dark:bg-orange-950 dark:text-orange-300">
              Digital Design
            </span>
            <h3 class="text-base font-semibold my-2">PYNQ-Z2 FPGA Racing FSM Logic</h3>
            <p class="text-xs opacity-80 leading-relaxed mb-3">
              Designed Finite State Machine (FSM) modules in Verilog HDL with custom testbenches for PYNQ-Z2 FPGA board deployment.
            </p>
            <div class="text-[11px] opacity-70 font-mono">Verilog • Vivado • FPGA</div>
          </div>
        </div>
      </div>

      <!-- 5. Activities & Experience -->
      <div class="mb-10">
        <h2 class="text-lg font-bold text-sky-600 dark:text-sky-400 mb-4 flex items-center gap-2">
          🏛️ Activities & Experience
        </h2>
        <div class="space-y-4">
          <div class="p-4 rounded-lg border border-border bg-accent/5">
            <div class="flex justify-between items-baseline mb-1">
              <h3 class="text-xs font-bold text-sky-600 dark:text-sky-400">Department Academic Study & Project Group</h3>
              <span class="text-[11px] opacity-60">Present</span>
            </div>
            <p class="text-xs opacity-80 leading-relaxed">
              Leading peer study groups on analog/digital circuits and embedded system projects; sharing course insights and design methodologies.
            </p>
          </div>

          <div class="p-4 rounded-lg border border-border bg-accent/5">
            <div class="flex justify-between items-baseline mb-1">
              <h3 class="text-xs font-bold text-orange-500 dark:text-orange-400">Educational Material Development & Hardware Mentoring</h3>
              <span class="text-[11px] opacity-60">Present</span>
            </div>
            <p class="text-xs opacity-80 leading-relaxed">
              Developing hands-on physical computing materials (Arduino-based sensor kits) and providing technical documentation for engineering activities.
            </p>
          </div>
        </div>
      </div>

      <!-- 6. Technical Skills -->
      <div>
        <h2 class="text-lg font-bold text-orange-500 dark:text-orange-400 mb-4 flex items-center gap-2">
          🛠️ Technical Skills
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
          <div class="rounded-lg border border-border p-4">
            <h3 class="font-bold text-sky-600 dark:text-sky-400 mb-2">Simulation & EDA</h3>
            <p class="opacity-80 leading-relaxed">Keysight ADS, Ansys HFSS, PSpice, Xschem, Eagle CAD</p>
          </div>
          <div class="rounded-lg border border-border p-4">
            <h3 class="font-bold text-sky-600 dark:text-sky-400 mb-2">Digital & Hardware</h3>
            <p class="opacity-80 leading-relaxed">Verilog HDL, Vivado, Quartus, PYNQ-Z2, Arduino</p>
          </div>
          <div class="rounded-lg border border-border p-4">
            <h3 class="font-bold text-sky-600 dark:text-sky-400 mb-2">Programming</h3>
            <p class="opacity-80 leading-relaxed">MATLAB, C/C++, Python</p>
          </div>
        </div>
      </div>

    </section>
  </main>
  <Footer />
</Layout>
