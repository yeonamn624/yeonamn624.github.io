---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-3xl font-bold sm:my-8 sm:text-4xl tracking-tight">
        <span class="text-accent">Jiwon Park</span> | Electromagnetics & RF
      </h1>

      <p class="mb-4 text-base leading-relaxed">
        Welcome! I am an Electrical and Electronic Engineering undergraduate student with a strong passion for high-frequency communications, wave propagation, and RF system design.
      </p>

      <p class="font-semibold mt-6 mb-2 text-sm uppercase tracking-wider text-accent">Core Focus Areas</p>
      <div class="flex flex-wrap gap-2 my-3">
        <span class="rounded border border-border bg-muted/50 px-3 py-1 text-sm font-medium text-foreground">RF & Microwave Engineering</span>
        <span class="rounded border border-border bg-muted/50 px-3 py-1 text-sm font-medium text-foreground">Antenna Theory & Design</span>
        <span class="rounded border border-border bg-muted/50 px-3 py-1 text-sm font-medium text-foreground">Simulation & Measurement</span>
      </div>

      <ul class="list-disc list-inside my-4 space-y-1.5 text-sm opacity-90 leading-relaxed">
        <li><strong>RF & Microwave Engineering:</strong> High-frequency circuit analysis, impedance matching, and passive/active component design.</li>
        <li><strong>Antenna Theory & Design:</strong> Radiating structures, electromagnetic field behavior, and wave propagation analysis.</li>
        <li><strong>Simulation & Measurement:</strong> Modeling high-frequency systems and measuring real-world signal characteristics.</li>
      </ul>

      <p class="mt-4 text-sm opacity-80 italic">
        This space serves as my digital engineering log—documenting coursework reflections, project updates, and theoretical explorations on my path toward becoming an RF engineer.
      </p>

      {
        socials.length > 0 && (
          <div class="mt-6 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
