---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-2xl font-bold sm:my-6 sm:text-3xl tracking-tight">
        RF & Microwave Engineering | <span class="text-sky-600">Jiwon Park</span>
      </h1>

      <p class="mb-4 text-base leading-relaxed">
        Welcome! I am an undergraduate student in the School of Electrical and Electronic Engineering at Yonsei University. This blog serves as my personal research notebook, centered on my academic interests in RF and microwave engineering, documenting coursework, projects, and other academic activities.
      </p>

      <!-- 파란 박스 영역: 코랄/오렌지 포인트 적용 -->
      <p class="font-semibold mt-6 mb-2 text-xs uppercase tracking-wider text-orange-600">Core Focus Areas</p>
      
      <div class="flex flex-wrap gap-2 my-3">
        <span class="rounded-md border border-orange-300 bg-orange-50 px-3 py-1.5 text-xs font-semibold text-orange-600">RF & Microwave Engineering</span>
        <span class="rounded-md border border-orange-300 bg-orange-50 px-3 py-1.5 text-xs font-semibold text-orange-600">Coursework & Projects</span>
        <span class="rounded-md border border-orange-300 bg-orange-50 px-3 py-1.5 text-xs font-semibold text-orange-600">Engineering Life</span>
      </div>

      <ul class="list-disc list-inside my-4 space-y-2 text-sm opacity-90 leading-relaxed">
        <li><strong class="text-orange-600">RF & Microwave Engineering:</strong> High-frequency circuit analysis, microwave component design, impedance matching, and wave propagation.</li>
        <li><strong class="text-orange-600">Coursework & Projects:</strong> Notes, reflections, and outcomes from classes and hands-on projects across my EE studies.</li>
        <li><strong class="text-orange-600">Engineering Life:</strong> Everyday logs, activities, and experiences from student life along the way.</li>
      </ul>

      <p class="mt-5 text-sm opacity-80 italic">
        This space serves as my digital research log—documenting coursework reflections, project updates, and academic explorations along my path as an engineering student.
      </p>

      {
        socials.length > 0 && (
          <div class="mt-6 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0 text-sm">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    <!-- 빨간 박스 영역: 포스트 카드 영역 (블루 & 코랄 교차 적용) -->
    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-10 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-xl font-semibold tracking-wide text-sky-600">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-10 pb-6">
          <h2 class="text-xl font-semibold tracking-wide text-sky-600">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
